# Victron SmartSolar MPPT — from VictronConnect → Product info
VICTRON_MAC=E8:18:52:D1:81:B7
VICTRON_KEY=your_32_char_hex_key_here

# Power Queen BMS Bluetooth MAC
BMS_MAC=C8:47:80:5D:08:6F

# Van dashboard server
VAN_PORT=80
VAN_PASSWORD=

# Session secret — used to sign the 30-day login cookie.
# Generate a random string: openssl rand -hex 32
VAN_SESSION_SECRET=change-me-to-a-random-string

# Optional: protect the API with a shared key
VAN_API_KEY=
