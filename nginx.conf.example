server {
    listen 80;
    server_name van-pi.local _;

    root /var/www/van;
    index index.html;

    # Frontend — SPA fallback so React Router works
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Backend API — strip /api prefix before forwarding to uvicorn
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    # Static photos served directly by nginx (faster than going through FastAPI)
    location /static/photos/ {
        alias /home/todd/van-control-panel/backend/photos/;
        expires 1h;
        add_header Cache-Control "public";
    }
}
