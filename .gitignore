# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Build output
frontend/dist/
frontend/.vite/

# Database — lives on Pi only, never committed
*.db
*.db-shm
*.db-wal

# Runtime state — persisted mode, written by the API
backend/mode.json
backend/*.tmp

# Environment
.env
.env.local
.env.*.local

# ESP32/ESPHome — secrets.yaml holds WiFi credentials and the API
# encryption key, same pattern as backend/.env.
esp32-dometic/secrets.yaml
esp32-dometic/.esphome/
esp32-dometic/*.bin

# Photos (local only, not committed)
backend/photos/interior/*.jpg
backend/photos/exterior/*.jpg

# OS
.DS_Store
Thumbs.db

# Editor — ignore personal/machine-specific files, keep the shared ones.
# tasks.json and extensions.json are project tooling worth surviving a
# machine rebuild; launch.json and sftp configs are not.
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Python
*.egg-info/
dist/
build/
.pytest_cache/

# Logs
*.log
