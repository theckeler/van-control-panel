server {
    listen 80;
    server_name van-pi.local _;

    # Camera photos used to be served directly here via alias, bypassing
    # Express entirely. Broken (nginx runs as www-data, which cannot
    # traverse /home/todd — mode 700 blocks it regardless of how open the
    # directories below it are) and insecure (no VAN_PASSWORD check, unlike
    # everything else). Removed 2026-09-04 — these now fall through to the
    # proxy below, which Express already handles correctly (auth wall, then
    # its own /static proxy to uvicorn).
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 10s;
    }
}
